# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=4000

# MongoDB Atlas connection string.
# Atlas dashboard -> Database -> Connect -> "Drivers" -> copy the URI, then
# swap in your DB user's password and add a database name after the host, e.g.:
# mongodb+srv://cutisUser:[email protected]/cutisDB?retryWrites=true&w=majority
MONGODB_URI=
# Local npm start reopens backend/.local_mongo_data when MONGODB_URI is blank.
# Set DISABLE_LOCAL_DB=true to require a configured MongoDB server locally.

# Any long random string — used to sign login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Email OTP delivery (Gmail example) ---
# 1. Turn on 2-Step Verification on the Google account you want to send from.
# 2. Create an "App Password": myaccount.google.com/apppasswords -> app "Mail".
# 3. Use that 16-character app password below (NOT your normal Gmail password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Cutis <[email protected]>"

# The deployed frontend origin, for CORS. Leave blank during local dev to allow all.
CLIENT_ORIGIN=

# --- SMS OTP (mobile number login), Twilio ---
# Create a Twilio account, buy/verify a number, then fill these. Trial accounts can only text verified numbers,
# and some countries (e.g. India) require sender registration before SMS is delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=   (use instead of TWILIO_FROM if you have a Messaging Service)

# --- Google sign-in ---
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Add your Netlify URL under "Authorized JavaScript origins". Paste the client ID here.
GOOGLE_CLIENT_ID=
CUTIS_GOOGLE_ONLY=false

# Twilio Verify (preferred for mobile OTP; no TWILIO_FROM required)
TWILIO_VERIFY_SERVICE_SID=
